{"chapter":112,"verses":[{"verse":1,"arabic":"قُلۡ هُوَ اللّٰهُ اَحَدٌۚ‏","urdu":"کہو کہ وہ (ذات پاک جس کا نام) الله (ہے) ایک ہے"},{"verse":2,"arabic":"اَللّٰهُ الصَّمَدُۚ‏","urdu":"معبود برحق جو بےنیاز ہے"},{"verse":3,"arabic":"لَمۡ يَلِدۡ ࣢ۙ وَلَمۡ يُوۡلَدۡۙ‏","urdu":"نہ کسی کا باپ ہے اور نہ کسی کا بیٹا"},{"verse":4,"arabic":"وَلَمۡ يَكُنۡ لَّهٗ كُفُوًا اَحَدٌࣖ‏","urdu":"اور کوئی اس کا ہمسر نہیں"}]}